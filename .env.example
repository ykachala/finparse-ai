# Server configuration
PORT=8000
ENVIRONMENT=development

# Database — async driver for the application, sync driver for Alembic/Celery
DATABASE_URL=postgresql+asyncpg://finparse:finparse@localhost:5432/finparse
SYNC_DATABASE_URL=postgresql://finparse:finparse@localhost:5432/finparse

# Redis
REDIS_URL=redis://localhost:6379/0

# Anthropic Claude API key
ANTHROPIC_API_KEY=sk-ant-...

# AWS credentials and S3 configuration
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_S3_BUCKET=finparse-documents
AWS_REGION=eu-west-1

# API key salt — generate with: openssl rand -hex 32
API_KEY_SALT=<generate: openssl rand -hex 32>

# Processing limits (optional — these are the defaults)
MAX_FILE_SIZE_MB=20
MAX_BATCH_SIZE=50
SYNC_PARSE_TIMEOUT_SECONDS=30
